# SplitFin — required environment variables
# Copy to .env for local, and set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real secrets.

# Neon Postgres (production DB — do not point production at localhost)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Auth.js (both naming schemes work; AUTH_* is preferred by Auth.js v5)
AUTH_SECRET=generate-with-npx-auth-secret
NEXTAUTH_SECRET=same-value-as-AUTH_SECRET-is-fine

# Canonical production origin — MUST include https:// and MUST NOT be VERCEL_URL alone
AUTH_URL=https://splitfinai.vercel.app
NEXTAUTH_URL=https://splitfinai.vercel.app

# Optional for server-side fetches; browser API client uses window.location.origin
NEXT_PUBLIC_APP_URL=https://splitfinai.vercel.app

# Google OAuth — Authorized redirect URI in Google Cloud Console MUST be exactly:
#   https://splitfinai.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=****
